# Base URL Flask backend, dipakai saat render di server (SSR / loader / server function).
# Dev: Flask lokal. Production: URL publik backend kamu.
API_BASE_URL=http://127.0.0.1:5000

# Base URL untuk request dari browser.
# Dev: path relatif, diteruskan oleh proxy Vite ke Flask (lihat vite.config.ts).
# Production: URL publik backend yang sama dengan API_BASE_URL, mis. https://api.example.com
VITE_API_BASE_URL=/api